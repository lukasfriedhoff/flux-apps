{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":disableRateLimiting"
  ],
  "labels": [
    "renovate"
  ],
  "flux": {
    "managerFilePatterns": [
      "/apps/.+\\.ya?ml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+\\.ya?ml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Pinned Nextcloud app tarballs seeded by initContainers. Renovate can only bump the release tag in the URL path; the postUpgradeTask below reconciles the versioned filename, the desired_version arg, and the sha256 (recomputed from the tarball) so the PR is complete and mergeable.",
      "managerFilePatterns": [
        "/apps/nextcloud/(helm-release|verify-custom-apps)\\.ya?ml$/"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>[^/]+/[^/]+)/releases/download/v(?<currentValue>[0-9.]+)/"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],
  "postUpgradeTasks": {
    "commands": [
      "node scripts/renovate/fix-nextcloud-app-pins.mjs"
    ],
    "fileFilters": [
      "apps/nextcloud/**"
    ],
    "executionMode": "branch"
  },
  "packageRules": [
    {
      "matchManagers": [
        "kubernetes"
      ],
      "groupName": "container images"
    }
  ]
}
