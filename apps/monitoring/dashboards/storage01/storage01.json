   "targets": [
    {
     "expr": "sum(up{instance=\"storage01\"})",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
