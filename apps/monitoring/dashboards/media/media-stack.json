          "editorMode": "code",
          "expr": "100 * kubelet_volume_stats_used_bytes{job=\"integrations/kubernetes/kubelet\", namespace=~\"$namespace\"} / kubelet_volume_stats_capacity_bytes{job=\"integrations/kubernetes/kubelet\", namespace=~\"$namespace\"}",
