          "editorMode": "code",
          "expr": "{namespace=~\"$namespace\"} |~ \"(?i)(error|exception|fail|panic|fatal|crash|denied)\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error Logs",
      "type": "logs"
